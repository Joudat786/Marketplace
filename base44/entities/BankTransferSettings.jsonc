{
  "name": "BankTransferSettings",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "is_enabled": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0628\u0646\u0643\u064a"
    },
    "instructions": {
      "type": "string",
      "description": "\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0644\u0644\u0639\u0645\u064a\u0644"
    },
    "payment_deadline_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u0641\u0639\u064a\u0644 \u0645\u0647\u0644\u0629 \u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u062a\u062d\u0648\u064a\u0644"
    },
    "payment_deadline_value": {
      "type": "integer",
      "default": 24,
      "description": "\u0642\u064a\u0645\u0629 \u0645\u0647\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "payment_deadline_unit": {
      "type": "string",
      "enum": [
        "minutes",
        "hours",
        "days"
      ],
      "default": "hours",
      "description": "\u0648\u062d\u062f\u0629 \u0645\u0647\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "auto_confirm": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0623\u0643\u064a\u062f \u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0644\u0637\u0644\u0628\u0627\u062a"
    },
    "require_transfer_proof": {
      "type": "boolean",
      "default": true,
      "description": "\u0625\u0638\u0647\u0627\u0631 \u062d\u0642\u0644 \u0631\u0641\u0639 \u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u062a\u062d\u0648\u064a\u0644"
    },
    "transfer_proof_required": {
      "type": "boolean",
      "default": false,
      "description": "\u0625\u062c\u0628\u0627\u0631\u064a\u0629 \u0631\u0641\u0639 \u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u062a\u062d\u0648\u064a\u0644"
    },
    "show_sender_name": {
      "type": "boolean",
      "default": false,
      "description": "\u0625\u0638\u0647\u0627\u0631 \u062d\u0642\u0644 \u0627\u0633\u0645 \u0627\u0644\u0645\u064f\u062d\u0648\u0650\u0651\u0644"
    },
    "sender_name_required": {
      "type": "boolean",
      "default": false,
      "description": "\u0625\u062c\u0628\u0627\u0631\u064a\u0629 \u0625\u062f\u062e\u0627\u0644 \u0627\u0633\u0645 \u0627\u0644\u0645\u064f\u062d\u0648\u0650\u0651\u0644"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u062f\u0627\u062e\u0644\u064a\u0629"
    }
  },
  "required": [
    "workspace_id"
  ]
}