{
  "name": "Currency",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u0644\u0629"
    },
    "code": {
      "type": "string",
      "description": "\u0631\u0645\u0632 \u0627\u0644\u0639\u0645\u0644\u0629 (\u0645\u062b\u0644 SAR, USD, EUR)"
    },
    "symbol": {
      "type": "string",
      "description": "\u0631\u0645\u0632 \u0627\u0644\u0639\u0645\u0644\u0629 \u0627\u0644\u0645\u0639\u0631\u0648\u0636 ($, \u0631.\u0633)"
    },
    "exchange_rate": {
      "type": "number",
      "description": "\u0645\u0639\u062f\u0644 \u0627\u0644\u0635\u0631\u0641 \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u0639\u0645\u0644\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0639\u0645\u0644\u0629 \u0645\u0641\u0639\u0644\u0629"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0627\u0644\u0639\u0645\u0644\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629"
    },
    "decimal_places": {
      "type": "integer",
      "default": 2,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0646\u0627\u0632\u0644 \u0627\u0644\u0639\u0634\u0631\u064a\u0629"
    },
    "thousands_separator": {
      "type": "string",
      "default": ",",
      "description": "\u0641\u0627\u0635\u0644\u0629 \u0627\u0644\u0622\u0644\u0627\u0641"
    },
    "decimal_separator": {
      "type": "string",
      "default": ".",
      "description": "\u0627\u0644\u0641\u0627\u0635\u0644\u0629 \u0627\u0644\u0639\u0634\u0631\u064a\u0629"
    },
    "symbol_position": {
      "type": "string",
      "enum": [
        "right",
        "left"
      ],
      "default": "right",
      "description": "\u0645\u0648\u0636\u0639 \u0631\u0645\u0632 \u0627\u0644\u0639\u0645\u0644\u0629 (\u064a\u0645\u064a\u0646 \u0623\u0648 \u064a\u0633\u0627\u0631)"
    },
    "symbol_space": {
      "type": "boolean",
      "default": false,
      "description": "\u0648\u0636\u0639 \u0645\u0633\u0627\u0641\u0629 \u0628\u064a\u0646 \u0627\u0644\u0631\u0645\u0632 \u0648\u0627\u0644\u0645\u0628\u0644\u063a"
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0639\u0631\u0636"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "name",
    "code",
    "exchange_rate"
  ]
}