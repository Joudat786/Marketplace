{
  "name": "ClientUpdateRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0637\u0644\u0628 \u0627\u0644\u062a\u062d\u062f\u064a\u062b"
    },
    "client_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 PlatformClient"
    },
    "client_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "client_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "old_data": {
      "type": "object",
      "description": "\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0642\u0628\u0644 \u0627\u0644\u062a\u0639\u062f\u064a\u0644"
    },
    "new_data": {
      "type": "object",
      "description": "\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u062a\u062d\u062f\u064a\u062b\u0647\u0627"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "returned"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628"
    },
    "rejection_reason": {
      "type": "string",
      "description": "\u0633\u0628\u0628 \u0627\u0644\u0631\u0641\u0636 \u0623\u0648 \u0627\u0644\u0625\u0631\u062c\u0627\u0639"
    },
    "reviewed_by": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0631\u0627\u062c\u0639"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    }
  },
  "required": [
    "client_id",
    "client_email",
    "old_data",
    "new_data"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}