{
  "name": "MyFatoorahSettings",
  "type": "object",
  "properties": {
    "is_enabled": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0641\u0639\u064a\u0644 \u0628\u0648\u0627\u0628\u0629 \u0645\u0627\u064a \u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "api_key": {
      "type": "string",
      "description": "\u0645\u0641\u062a\u0627\u062d API \u0627\u0644\u062e\u0627\u0635 \u0628\u062d\u0633\u0627\u0628 \u0645\u0627\u064a \u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "country_code": {
      "type": "string",
      "default": "SAU",
      "description": "\u0631\u0645\u0632 \u0627\u0644\u062f\u0648\u0644\u0629: SAU, ARE, QAT, EGY, KWT, BHR, OMN, JOR"
    },
    "base_url": {
      "type": "string",
      "default": "https://api-sa.myfatoorah.com",
      "description": "\u0631\u0627\u0628\u0637 API - \u064a\u064f\u062d\u062f\u064e\u0651\u062f \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "test"
      ],
      "default": "test",
      "description": "\u0648\u0636\u0639 \u0627\u0644\u062a\u0634\u063a\u064a\u0644: live \u0623\u0648 test"
    },
    "supplier_code": {
      "type": "string",
      "description": "\u0643\u0648\u062f \u0627\u0644\u0645\u0648\u0631\u062f (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "webhook_secret": {
      "type": "string",
      "description": "\u0633\u0631 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0640 Webhook (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "default_currency": {
      "type": "string",
      "default": "SAR",
      "description": "\u0627\u0644\u0639\u0645\u0644\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629"
    },
    "success_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0628\u0639\u062f \u0646\u062c\u0627\u062d \u0627\u0644\u062f\u0641\u0639"
    },
    "error_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0628\u0639\u062f \u0641\u0634\u0644 \u0627\u0644\u062f\u0641\u0639"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u062f\u0627\u062e\u0644\u064a\u0629"
    }
  },
  "required": []
}