{
  "name": "App",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "short_description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0645\u062e\u062a\u0635\u0631 \u0644\u0644\u062a\u0637\u0628\u064a\u0642 (\u064a\u0638\u0647\u0631 \u0641\u064a \u0645\u062a\u062c\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a)"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a (\u064a\u0638\u0647\u0631 \u0641\u064a \u062a\u0628\u0648\u064a\u0628\u0629 \u0627\u0644\u0648\u0635\u0641 \u0648\u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645)"
    },
    "icon_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "video_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0641\u064a\u062f\u064a\u0648 \u0634\u0631\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 (\u064a\u0648\u062a\u064a\u0648\u0628 \u0623\u0648 \u0631\u0627\u0628\u0637 \u0645\u0628\u0627\u0634\u0631 \u0623\u0648 \u0645\u0631\u0641\u0648\u0639)"
    },
    "video_type": {
      "type": "string",
      "enum": [
        "youtube",
        "url",
        "uploaded"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0638\u0647\u0631 \u0641\u064a\u0647\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
