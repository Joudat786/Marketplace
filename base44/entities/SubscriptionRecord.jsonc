{
  "name": "SubscriptionRecord",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0634\u062a\u0631\u0643"
    },
    "workspace_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0647\u0630\u0627 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "workspace_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644 (\u0644\u0644\u0639\u0631\u0636)"
    },
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0627\u0642\u0629 \u0623\u0648 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "type": {
      "type": "string",
      "enum": [
        "plan",
        "app"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643: \u0628\u0627\u0642\u0629 \u0623\u0648 \u062a\u0637\u0628\u064a\u0642"
    },
    "plan_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0628\u0627\u0642\u0629 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "app_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "subscription_source": {
      "type": "string",
      "enum": [
        "plan",
        "addon",
        "free"
      ],
      "default": "plan",
      "description": "\u0645\u0635\u062f\u0631 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643: plan=\u0645\u0646 \u0627\u0644\u0628\u0627\u0642\u0629\u060c addon=\u062a\u0637\u0628\u064a\u0642 \u0645\u0634\u062a\u0631\u0649 \u0645\u0646\u0641\u0631\u062f\u0627\u064b\u060c free=\u0645\u062c\u0627\u0646\u064a"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u2014 \u063a\u064a\u0631 \u0645\u0648\u062c\u0648\u062f \u064a\u0639\u0646\u064a \u063a\u064a\u0631 \u0645\u062d\u062f\u0648\u062f"
    },
    "amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639"
    },
    "currency": {
      "type": "string",
      "default": "SAR",
      "description": "\u0627\u0644\u0639\u0645\u0644\u0629"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "description": "\u062f\u0648\u0631\u0629 \u0627\u0644\u0641\u0648\u062a\u0631\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "expired",
        "suspended"
      ],
      "default": "active",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "auto_renew": {
      "type": "boolean",
      "default": true,
      "description": "\u062a\u062c\u062f\u064a\u062f \u062a\u0644\u0642\u0627\u0626\u064a"
    },
    "payment_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"
    }
  },
  "required": [
    "user_email",
    "name",
    "type",
    "start_date",
    "amount"
  ]
}