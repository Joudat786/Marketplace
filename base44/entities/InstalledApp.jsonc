{
  "name": "InstalledApp",
  "type": "object",
  "properties": {
    "app_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0645\u062b\u0628\u064e\u0651\u062a"
    },
    "app_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 (\u064a\u064f\u062d\u0641\u0638 \u0639\u0646\u062f \u0627\u0644\u062a\u062b\u0628\u064a\u062a \u0644\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u064a\u0647 \u0628\u062f\u0648\u0646 join)"
    },
    "installed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "workspace_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644 (\u0645\u0637\u0644\u0648\u0628 \u0644\u0644\u0639\u0645\u0644\u0627\u0621\u060c null \u0644\u0644\u0633\u0648\u0628\u0631 \u0623\u062f\u0645\u0646)"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "super_admin",
        "workspace"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0627\u0644\u0643: super_admin \u0623\u0648 workspace"
    },
    "owner_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644 \u0623\u0648 \u0645\u0633\u062a\u062e\u062f\u0645 (null \u0644\u0644\u0633\u0648\u0628\u0631 \u0623\u062f\u0645\u0646)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "trial",
        "expired",
        "pending_payment",
        "pending_setup",
        "uninstalled"
      ],
      "default": "pending_setup",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0645\u062b\u0628\u064e\u0651\u062a: uninstalled = \u0623\u0644\u063a\u0649 \u0627\u0644\u062a\u062b\u0628\u064a\u062a \u0644\u0643\u0646 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0644\u0627 \u064a\u0632\u0627\u0644 \u0646\u0634\u0637\u0627\u064b (\u064a\u0645\u0643\u0646 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u062b\u0628\u064a\u062a)"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u062c\u0631\u0628\u0629"
    },
    "subscription_ends_at": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0627\u0644\u0645\u062f\u0641\u0648\u0639"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "monthly",
      "description": "\u062f\u0648\u0631\u0629 \u0627\u0644\u0641\u0648\u062a\u0631\u0629"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "unpaid",
        "trial",
        "free"
      ],
      "default": "free",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "client_config": {
      "type": "object",
      "description": "\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0631\u0628\u0637 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (\u0645\u0641\u0627\u062a\u064a\u062d API\u060c \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0639\u062a\u0645\u0627\u062f\u060c ...) - \u0645\u0639\u0632\u0648\u0644\u0629 \u0644\u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0627\u062d\u0629 \u0641\u0642\u0637"
    },
    "is_configured": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u062a\u0645 \u0625\u0639\u062f\u0627\u062f/\u0631\u0628\u0637 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "custom_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0645\u062e\u0635\u0635 \u0644\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0646 \u0642\u0650\u0628\u064e\u0644 \u0627\u0644\u0639\u0645\u064a\u0644 (\u064a\u064f\u0639\u0631\u0636 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0635\u0644\u064a)"
    },
    "custom_icon_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0644\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0646 \u0642\u0650\u0628\u064e\u0644 \u0627\u0644\u0639\u0645\u064a\u0644 (\u062a\u064f\u0639\u0631\u0636 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629)"
    },
    "uninstalled_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u062b\u0628\u064a\u062a"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "app_id",
    "owner_type"
  ]
}