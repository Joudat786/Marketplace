{
  "name": "PlatformClient",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a"
    },
    "owner_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0627\u0644\u0643 / \u0627\u0644\u0645\u062f\u064a\u0631"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644"
    },
    "activity_type": {
      "type": "string",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0643\u064a\u0627\u0646 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a - Legal Entity Type"
    },
    "unified_national_number": {
      "type": "string",
      "description": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u0645\u0648\u062d\u062f"
    },
    "commercial_register_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "commercial_register_issue_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "commercial_register_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "tax_number": {
      "type": "string",
      "description": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "tax_registration_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0646\u0641\u0627\u0630 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "commercial_register_attachment": {
      "type": "string",
      "description": "\u0645\u0631\u0641\u0642 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "founding_contract_attachment": {
      "type": "string",
      "description": "\u0645\u0631\u0641\u0642 \u0639\u0642\u062f \u0627\u0644\u062a\u0623\u0633\u064a\u0633"
    },
    "tax_certificate_attachment": {
      "type": "string",
      "description": "\u0645\u0631\u0641\u0642 \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0627\u0644\u0636\u0631\u064a\u0628\u064a\u0629"
    },
    "identity_attachment": {
      "type": "string",
      "description": "\u0645\u0631\u0641\u0642 \u0627\u0644\u0647\u0648\u064a\u0629"
    },
    "national_address_attachment": {
      "type": "string",
      "description": "\u0645\u0631\u0641\u0642 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0648\u0637\u0646\u064a"
    },
    "workspaces_count": {
      "type": "integer",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u0633\u0627\u062d\u0627\u062a \u0627\u0644\u0639\u0645\u0644"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "cancelled"
      ],
      "default": "active",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "join_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 (\u0623\u0648\u0644 \u062a\u0633\u062c\u064a\u0644 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645)"
    },
    "data_completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a (\u0623\u0648\u0644 \u0645\u0631\u0629 \u064a\u0643\u0645\u0644 \u0641\u064a\u0647\u0627 \u0627\u0644\u0639\u0645\u064a\u0644 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0640 Onboarding)"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          },
          "identity_type": {
            "type": "string",
            "enum": [
              "national_id",
              "passport",
              "resident_id"
            ]
          },
          "identity_number": {
            "type": "string"
          },
          "identity_attachment": {
            "type": "string"
          },
          "in_founding_contract": {
            "type": "boolean"
          }
        }
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0645\u0644\u0627\u0643 \u0627\u0644\u0634\u0631\u0643\u0629 / \u0627\u0644\u0645\u0624\u0633\u0633\u0629"
    },
    "owner_data": {
      "type": "object",
      "properties": {
        "nationality": {
          "type": "string"
        },
        "identity_type": {
          "type": "string",
          "enum": [
            "national_id",
            "passport",
            "resident_id"
          ]
        },
        "identity_number": {
          "type": "string"
        }
      }
    },
    "location_data": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "national_address_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "governorate": {
          "type": "string"
        },
        "neighborhood": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "address_description": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}