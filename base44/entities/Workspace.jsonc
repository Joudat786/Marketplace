{
  "name": "Workspace",
  "type": "object",
  "properties": {
    "workspace_number": {
      "type": "integer",
      "description": "\u0631\u0642\u0645 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644 \u0644\u0644\u0639\u0631\u0636 \u0627\u0644\u0628\u0634\u0631\u064a: 1=\u0625\u062f\u0627\u0631\u064a\u0629, 2,3,...=\u0633\u0648\u0628\u0631 \u0623\u062f\u0645\u0646, 100000001+=\u0639\u0645\u0644\u0627\u0621"
    },
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "workspace_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644 - \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u0631\u0628\u0637 \u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649 \u0628\u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0627\u062d\u0629"
    },
    "slug": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0639\u0631\u0641 \u0627\u0644\u0641\u0631\u064a\u062f"
    },
    "owner_user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0627\u0644\u0643"
    },
    "owner_email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u0627\u0644\u0643"
    },
    "logo_url": {
      "type": "string",
      "description": "\u0634\u0639\u0627\u0631 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "trial",
        "cancelled"
      ],
      "default": "active"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "professional",
        "enterprise"
      ],
      "default": "free"
    },
    "plan_expires_at": {
      "type": "string",
      "format": "date"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "monthly"
    },
    "currency": {
      "type": "string",
      "default": "SAR"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Riyadh"
    },
    "language": {
      "type": "string",
      "default": "ar"
    },
    "settings": {
      "type": "object"
    },
    "additional_users_count": {
      "type": "integer",
      "default": 0
    },
    "additional_workspaces_count": {
      "type": "integer",
      "default": 0
    },
    "additional_storage_gb": {
      "type": "integer",
      "default": 0
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          },
          "identity_type": {
            "type": "string",
            "enum": [
              "national_id",
              "passport",
              "resident_id"
            ]
          },
          "identity_number": {
            "type": "string"
          },
          "identity_attachment": {
            "type": "string"
          },
          "in_founding_contract": {
            "type": "boolean"
          }
        }
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0645\u0644\u0627\u0643 \u0627\u0644\u0634\u0631\u0643\u0629 / \u0627\u0644\u0645\u0624\u0633\u0633\u0629"
    },
    "owner_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0645\u0627\u0644\u0643 \u0627\u0644\u0634\u0631\u0643\u0629 / \u0627\u0644\u0645\u0624\u0633\u0633\u0629 (\u0642\u062f\u064a\u0645 - \u0644\u0644\u062a\u0648\u0627\u0641\u0642)"
    },
    "owner_mobile": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u062c\u0648\u0627\u0644 \u0645\u0627\u0644\u0643 \u0627\u0644\u0634\u0631\u0643\u0629 / \u0627\u0644\u0645\u0624\u0633\u0633\u0629"
    },
    "owner_nationality": {
      "type": "string",
      "description": "\u062c\u0646\u0633\u064a\u0629 \u0645\u0627\u0644\u0643 \u0627\u0644\u0634\u0631\u0643\u0629 / \u0627\u0644\u0645\u0624\u0633\u0633\u0629"
    },
    "owner_identity_type": {
      "type": "string",
      "enum": [
        "national_id",
        "resident_id",
        "passport"
      ],
      "description": "\u0646\u0648\u0639 \u0647\u0648\u064a\u0629 \u0645\u0627\u0644\u0643 \u0627\u0644\u0634\u0631\u0643\u0629 / \u0627\u0644\u0645\u0624\u0633\u0633\u0629"
    },
    "owner_identity_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0647\u0648\u064a\u0629 \u0645\u0627\u0644\u0643 \u0627\u0644\u0634\u0631\u0643\u0629 / \u0627\u0644\u0645\u0624\u0633\u0633\u0629"
    },
    "company_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 / \u0627\u0644\u0645\u0624\u0633\u0633\u0629"
    },
    "unified_national_number": {
      "type": "string",
      "description": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u0645\u0648\u062d\u062f"
    },
    "commercial_register_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "commercial_register_issue_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "commercial_register_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "tax_number": {
      "type": "string",
      "description": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "tax_registration_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0646\u0641\u0627\u0630 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "activity_type": {
      "type": "string",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0643\u064a\u0627\u0646 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a - Legal Entity Type"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "location_data": {
      "type": "object",
      "description": "\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a"
    },
    "footer_text": {
      "type": "string",
      "description": "\u0646\u0635 \u0627\u0644\u062a\u0630\u064a\u064a\u0644 \u0627\u0644\u062e\u0627\u0635 \u0628\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "commercial_register_attachment": {
      "type": "string",
      "description": "\u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a (\u0645\u0631\u0641\u0642)"
    },
    "founding_contract_attachment": {
      "type": "string",
      "description": "\u0639\u0642\u062f \u0627\u0644\u062a\u0623\u0633\u064a\u0633 (\u0645\u0631\u0641\u0642)"
    },
    "tax_certificate_attachment": {
      "type": "string",
      "description": "\u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0627\u0644\u0636\u0631\u064a\u0628\u064a\u0629 (\u0645\u0631\u0641\u0642)"
    },
    "identity_attachment": {
      "type": "string",
      "description": "\u0627\u0644\u0647\u0648\u064a\u0629 (\u0645\u0631\u0641\u0642)"
    },
    "national_address_attachment": {
      "type": "string",
      "description": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0648\u0637\u0646\u064a (\u0645\u0631\u0641\u0642)"
    },
    "is_admin_workspace": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0647\u064a \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 (\u0631\u0642\u0645 1) - \u0644\u0627 \u064a\u0645\u0643\u0646 \u062d\u0630\u0641\u0647\u0627"
    },
    "is_protected": {
      "type": "boolean",
      "default": false,
      "description": "\u0645\u062d\u0645\u064a\u0629 \u0645\u0646 \u0627\u0644\u062d\u0630\u0641"
    },
    "workspace_owner_type": {
      "type": "string",
      "enum": [
        "super_admin",
        "client"
      ],
      "default": "client",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0627\u0644\u0643: super_admin \u0623\u0648 client"
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "workspace_owner_type": "super_admin"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}