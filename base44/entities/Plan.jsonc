{
  "name": "Plan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "description": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "is_free": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0627\u0644\u0628\u0627\u0642\u0629 \u0645\u062c\u0627\u0646\u064a\u0629"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0647\u0630\u0647 \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0644\u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u062c\u062f\u062f"
    },
    "monthly_price": {
      "type": "number",
      "description": "\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0634\u0647\u0631\u064a"
    },
    "yearly_price": {
      "type": "number",
      "description": "\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0633\u0646\u0648\u064a"
    },
    "max_users": {
      "type": "integer",
      "description": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0633\u0627\u062d\u0629"
    },
    "max_storage": {
      "type": "integer",
      "description": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 (GB) \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0633\u0627\u062d\u0629"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0646\u0635\u064a\u0629 (\u0642\u062f\u064a\u0645)"
    },
    "included_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0645\u0639\u0631\u0651\u0641\u0627\u062a PlanFeature \u0627\u0644\u0645\u062f\u0631\u062c\u0629 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "included_apps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u0636\u0645\u0646\u0629 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0628\u0627\u0642\u0629"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0628\u0627\u0642\u0629 \u0645\u0641\u0639\u0651\u0644\u0629"
    },
    "color": {
      "type": "string",
      "enum": [
        "slate",
        "blue",
        "purple",
        "indigo"
      ],
      "default": "blue",
      "description": "\u0644\u0648\u0646 \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0645\u062d\u062f\u062f \u0645\u0633\u0628\u0642\u0627\u064b"
    },
    "custom_color": {
      "type": "string",
      "description": "\u0644\u0648\u0646 \u0645\u062e\u0635\u0635 \u0628\u0635\u064a\u063a\u0629 Hex (#RRGGBB) \u0639\u0646\u062f \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631"
    },
    "subscribers_count": {
      "type": "integer",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u064a\u0646"
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0639\u0631\u0636"
    },
    "is_popular": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0647\u064a \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0634\u064a\u0648\u0639\u0627\u064b"
    },
    "popular_label": {
      "type": "string",
      "default": "\u0627\u0644\u0623\u0643\u062b\u0631 \u0634\u064a\u0648\u0639\u0627\u064b",
      "description": "\u0646\u0635 \u0634\u0627\u0631\u0629 \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0645\u0645\u064a\u0632\u0629"
    },
    "has_trial": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u062a\u062f\u0639\u0645 \u0641\u062a\u0631\u0629 \u062a\u062c\u0631\u064a\u0628\u064a\u0629"
    },
    "trial_days": {
      "type": "integer",
      "default": 14,
      "description": "\u0639\u062f\u062f \u0623\u064a\u0627\u0645 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629"
    },
    "additional_user_price_monthly": {
      "type": "number",
      "default": 0,
      "description": "\u0633\u0639\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0625\u0636\u0627\u0641\u064a \u0627\u0644\u0648\u0627\u062d\u062f (\u0634\u0647\u0631\u064a)"
    },
    "additional_user_price_yearly": {
      "type": "number",
      "default": 0,
      "description": "\u0633\u0639\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0625\u0636\u0627\u0641\u064a \u0627\u0644\u0648\u0627\u062d\u062f (\u0633\u0646\u0648\u064a)"
    },
    "additional_storage_price_monthly": {
      "type": "number",
      "default": 0,
      "description": "\u0633\u0639\u0631 GB \u0648\u0627\u062d\u062f \u0625\u0636\u0627\u0641\u064a \u0645\u0646 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 (\u0634\u0647\u0631\u064a)"
    },
    "additional_storage_price_yearly": {
      "type": "number",
      "default": 0,
      "description": "\u0633\u0639\u0631 GB \u0648\u0627\u062d\u062f \u0625\u0636\u0627\u0641\u064a \u0645\u0646 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 (\u0633\u0646\u0648\u064a)"
    }
  },
  "required": [
    "name",
    "monthly_price",
    "yearly_price",
    "max_users",
    "max_storage"
  ]
}