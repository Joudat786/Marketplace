{
  "name": "JoinRequest",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "workspace_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "workspace_logo": {
      "type": "string",
      "description": "\u0634\u0639\u0627\u0631 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "requester_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0637\u0627\u0644\u0628 \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645"
    },
    "requester_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0637\u0627\u0644\u0628 \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645"
    },
    "owner_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0645\u0627\u0644\u0643 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    }
  },
  "required": [
    "workspace_id",
    "requester_email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "requester_email": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "requester_email": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "requester_email": "{{user.email}}"
        },
        {
          "owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}